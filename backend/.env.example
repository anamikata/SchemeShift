# Create a Gemini API key in your own Google AI Studio account.
# Do not commit your real key or upload it to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Defaults to gemini-3.5-flash-lite; set blank to disable capacity fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
MAX_UPLOAD_MB=18

# Comma-separated origins allowed to call the API (include your deployed frontend origin when needed).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
