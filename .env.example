# Copy to .env for Docker Compose. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Defaults to gemini-3.5-flash-lite; set blank to disable capacity fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
MAX_UPLOAD_MB=18
SCHEMESHIFT_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080
